ConnectionStrings__DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=EFUInventoryDbV3;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=EFU.Inventory
Jwt__Audience=EFU.Inventory.Frontend
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7
FrontendUrl=http://localhost:5173
SMTP__Host=
SMTP__Port=587
SMTP__Username=
SMTP__Password=
BootstrapAdmin__Email=
BootstrapAdmin__Password=
SMTP__From=no-reply@example.com
SMTP__EnableSsl=true
BackendUrl=http://localhost:5000
FileStorage__Root=uploads

# Optional database component variables for deployment tooling / secret stores
DB_HOST=(localdb)\MSSQLLocalDB
DB_PORT=1433
DB_NAME=EFUInventoryDbV3
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true
