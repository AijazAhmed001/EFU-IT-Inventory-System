ConnectionStrings__DefaultConnection=Server=(localdb)\\MSSQLLocalDB;Database=EFUInventoryDbV3;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
Jwt__Secret=replace-with-a-long-random-secret-at-least-32-characters
Jwt__Issuer=EFU.Inventory
Jwt__Audience=EFU.Inventory.Frontend
Jwt__AccessTokenMinutes=30
Jwt__RefreshTokenDays=7
FrontendUrl=http://localhost:5173
SMTP__Host=
SMTP__Port=587
SMTP__Username=
SMTP__Password=
BootstrapAdmin__Email=
BootstrapAdmin__Password=
SMTP__From=no-reply@example.com
SMTP__EnableSsl=true
SMTP__TimeoutMilliseconds=30000
BackendUrl=http://localhost:5000
FileStorage__Root=uploads

# Optional database component variables for deployment tooling / secret stores
DB_HOST=(localdb)\MSSQLLocalDB
DB_PORT=1433
DB_NAME=EFUInventoryDbV3
DB_USERNAME=
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Asset expiry reminder scheduler (safe example values; no secrets)
AssetExpiryReminders__Enabled=true
AssetExpiryReminders__ExecutionTime=09:00
AssetExpiryReminders__TimeZone=Asia/Karachi
AssetExpiryReminders__ReminderWindowDays=15
AssetExpiryReminders__SendEveryDay=true
AssetExpiryReminders__SendOnExpiryDate=true
AssetExpiryReminders__SendAfterExpiry=false
AssetExpiryReminders__PostExpiryDays=0
AssetExpiryReminders__CcItSupport=
AssetExpiryReminders__Bcc=
AssetExpiryReminders__MaximumRetryCount=3
AssetExpiryReminders__SenderName=EFU IT Department
AssetExpiryReminders__SubjectPrefix=[EFU IT Inventory]
AssetExpiryReminders__NotifyAdminOnMissingEmail=false
AssetExpiryReminders__BatchSize=100
# Purchase order numbering is created by migration 007. Change the sequence start in a controlled
# deployment migration if legacy Oracle numbering requires a different non-colliding range.
# Oracle purchase-order synchronization remains disabled until an approved gateway is configured.
