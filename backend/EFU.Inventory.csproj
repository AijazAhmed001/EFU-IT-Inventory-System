<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EFU.Inventory</RootNamespace>
    <AssemblyName>EFU.Inventory</AssemblyName>
    <UserSecretsId>EFU.Inventory.Development</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
  </ItemGroup>

  <!-- Compile the feature-oriented implementation and exclude the superseded
       pre-merge root copies that define the same namespaces and types. -->
  <ItemGroup>
    <Compile Remove="Controllers\**\*.cs" />
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="DTOs\**\*.cs" />
    <Compile Remove="Extensions\**\*.cs" />
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Database\Migrations\**\*.sql"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
